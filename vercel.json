{
  "regions": [
    "sin1"
  ],
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/digest.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/evaluate.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/lead.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/webhook",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/webhook",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/digest",
      "dest": "api/digest.py"
    },
    {
      "src": "/api/evaluate",
      "dest": "api/evaluate.py"
    },
    {
      "src": "/api/lead",
      "dest": "api/lead.py"
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/evaluate",
      "schedule": "0 4 * * *"
    }
  ]
}
